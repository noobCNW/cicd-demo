<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>javademo</artifactId>
  <version>1.0.0</version>
  <name>javademo</name>
  <description>Demo app consuming configs from Nacos config center</description>

  <properties>
    <java.version>17</java.version>
    <nacos.client.version>2.3.2</nacos.client.version>
    <!-- 与 Spring Boot 3.2.5（logback 1.4.14 / Jackson 2.15.x）兼容：7.4 针对 logback 1.3.x + Jackson 2.15 编译，二进制兼容 -->
    <logstash.logback.encoder.version>7.4</logstash.logback.encoder.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 直接使用 Nacos OpenAPI 客户端拉取/监听配置（不引入 spring-cloud-alibaba 全家桶，避免版本匹配风险） -->
    <dependency>
      <groupId>com.alibaba.nacos</groupId>
      <artifactId>nacos-client</artifactId>
      <version>${nacos.client.version}</version>
    </dependency>
    <!-- JSON 行日志（logback-spring.xml 中 LogstashEncoder 使用） -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash.logback.encoder.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>javademo</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
